# Canonical site URL, used for canonical links, OG/Twitter tags, JSON-LD, sitemap, and robots.txt.
NUXT_PUBLIC_SITE_URL=https://example.org

# Username only (no URL) — used to build https://t.me/<username>
NUXT_PUBLIC_TELEGRAM_USERNAME=username

# Username only (no URL) — used to build https://ble.ir/<username>
NUXT_PUBLIC_BALE_USERNAME=username

# Plain email address (no obfuscation) — used to build the mailto: link
NUXT_PUBLIC_SUPPORT_EMAIL=support@example.org

# Hostname only (no protocol) — used to build the WHM panel link
NUXT_PUBLIC_WHM_HOST=whm.example.org

# Hostname only (no protocol) — used to build the cPanel panel link
NUXT_PUBLIC_CPANEL_HOST=cpanel.example.org
